<?xml version="1.0" encoding="UTF-8"?>
<!--
  Jsonix customizations for generating Office Open XML (docx4j) mappings.
  Attached to docx4j's ROOT.xsd; the mapping names and packages come from the jaxb:package
  annotations inside the docx4j schemas themselves (org.docx4j.wml -> org_docx4j_wml, ...).
-->
<jaxb:bindings version="3.0"
	xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb"
	xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	xmlns:jsonix="http://jsonix.highsource.org/customizations"
	jaxb:extensionBindingPrefixes="jsonix">

	<jaxb:bindings schemaLocation="../../docx4j/xsd/ROOT.xsd" node="/xsd:schema">
		<!-- Defaults for every module: UMD mapping, ES-module mapping, TypeScript declarations. -->
		<jsonix:output naming="standard"/>
		<jsonix:output naming="standard" format="esm"/>
		<jsonix:typeScript/>

		<!-- Equivalents of docx4j's ModifyGeneratedSources (CR-007). Mapping names stay the defaults
		     (package name with underscores); these elements only add customizations. -->
		<jsonix:mapping package="org.docx4j.vml">
			<!-- Word is sensitive to the order of these attributes on v:line: https://github.com/plutext/docx4j/issues/469 -->
			<jsonix:propertyOrder typeInfo="CTLine">vmlId style from to</jsonix:propertyOrder>
		</jsonix:mapping>
		<jsonix:mapping package="org.docx4j.wml">
			<!-- An absent w:customStyle means a built-in style, whatever the schema default says: https://github.com/plutext/docx4j/issues/641 -->
			<jsonix:property name="Style.customStyle" defaultValue="false"/>
		</jsonix:mapping>
	</jaxb:bindings>

</jaxb:bindings>
