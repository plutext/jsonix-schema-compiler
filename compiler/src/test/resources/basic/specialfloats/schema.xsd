<?xml version="1.0" encoding="UTF-8"?>
<!-- XML Schema's special float/double values (NaN, INF, -INF) as defaults and enumerations;
     docx4j's dml-diagramDefinition.xsd uses default="NaN" on xs:double attributes. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
	xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb" jaxb:version="3.0"
	targetNamespace="urn:test:specialfloats" xmlns="urn:test:specialfloats" elementFormDefault="qualified">
	<xs:annotation>
		<xs:appinfo>
			<jaxb:schemaBindings>
				<jaxb:package name="test.specialfloats"/>
			</jaxb:schemaBindings>
		</xs:appinfo>
	</xs:annotation>
	<xs:element name="root" type="RootType"/>
	<xs:complexType name="RootType">
		<xs:sequence>
			<xs:element name="ratio" type="xs:double" default="INF" minOccurs="0"/>
			<xs:element name="floor" type="xs:float" default="-INF" minOccurs="0"/>
		</xs:sequence>
		<xs:attribute name="scale" type="xs:double" default="NaN"/>
	</xs:complexType>
</xs:schema>
