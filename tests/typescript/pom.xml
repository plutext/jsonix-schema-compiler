<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>jsonix-schema-compiler-test-typescript</artifactId>
	<packaging>jar</packaging>
	<name>Jsonix Schema Compiler Test [typescript]</name>
	<description>Generates TypeScript declarations, an ES module and element factories for the purchase order schema, type-checks them with the @docx4j/jsonix runtime typings, and unmarshals and marshals through the runtime (CR-005, CR-010; jsonix-CR-001 item 6). Requires node/npm and the @docx4j/jsonix runtime (see jsonix.runtime.dependency); skip with -Dskip.typescript=true.</description>
	<parent>
		<groupId>org.hisrc.jsonix</groupId>
		<artifactId>jsonix-schema-compiler-tests</artifactId>
		<version>2.3.10-SNAPSHOT</version>
	</parent>
	<properties>
		<skip.typescript>false</skip.typescript>
		<!-- The @docx4j/jsonix runtime (3.2.0: generic typings, ES-module entry, parent pointers). Until 3.2.0 is on
		     npm this points at the sibling checkout (plutext/jsonix); override with -Djsonix.runtime.dependency=^3.2.0
		     once published, and make that the default. -->
		<jsonix.runtime.dependency>file:../../../jsonix/nodejs/scripts</jsonix.runtime.dependency>
	</properties>
	<dependencies>
		<dependency>
			<groupId>jakarta.xml.bind</groupId>
			<artifactId>jakarta.xml.bind-api</artifactId>
		</dependency>
		<dependency>
			<groupId>org.glassfish.jaxb</groupId>
			<artifactId>jaxb-runtime</artifactId>
		</dependency>
		<dependency>
			<groupId>org.hisrc.jsonix</groupId>
			<artifactId>jsonix-schema-compiler</artifactId>
		</dependency>
	</dependencies>
	<build>
		<plugins>
			<plugin>
				<artifactId>maven-resources-plugin</artifactId>
				<executions>
					<execution>
						<!-- package.json with the @docx4j/jsonix dependency resolved from ${jsonix.runtime.dependency} -->
						<id>copy-package.json</id>
						<phase>initialize</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${basedir}</outputDirectory>
							<resources>
								<resource>
									<directory>src/main/npm</directory>
									<filtering>true</filtering>
								</resource>
							</resources>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.jvnet.jaxb</groupId>
				<artifactId>jaxb-maven-plugin</artifactId>
				<configuration>
					<extension>true</extension>
					<!-- The generated files depend on the compiler, not only on the schema: always regenerate. -->
					<forceRegenerate>true</forceRegenerate>
					<args>
						<arg>-Xjsonix</arg>
						<arg>-Xjsonix-generateTypeScript</arg>
						<arg>-Xjsonix-generateFactories</arg>
					</args>
					<plugins>
						<plugin>
							<groupId>org.hisrc.jsonix</groupId>
							<artifactId>jsonix-schema-compiler</artifactId>
							<version>${project.version}</version>
						</plugin>
					</plugins>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>npm-install</id>
						<phase>process-test-resources</phase>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<skip>${skip.typescript}</skip>
							<executable>npm</executable>
							<arguments>
								<argument>install</argument>
								<argument>--no-audit</argument>
								<argument>--no-fund</argument>
							</arguments>
						</configuration>
					</execution>
					<execution>
						<id>esm-smoke</id>
						<phase>test</phase>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<skip>${skip.typescript}</skip>
							<executable>node</executable>
							<arguments>
								<argument>src/test/javascript/esm-smoke.mjs</argument>
							</arguments>
						</configuration>
					</execution>
					<execution>
						<id>tsc</id>
						<phase>test</phase>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<skip>${skip.typescript}</skip>
							<executable>npx</executable>
							<arguments>
								<argument>tsc</argument>
								<argument>-p</argument>
								<argument>tsconfig.json</argument>
							</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
